---
/**
 * /waves — a live one-bit ink print of the shore at Kochi, Japan.
 * One WebGL2 fragment shader (fbm clouds on a projected sky plane, perspective
 * sea, swash) Bayer-dithered to ink on paper, driven by the real weather:
 * wind sets the swell's pace, cloud cover fills the sky, precipitation hangs
 * rain squalls offshore, and the sun keeps Kochi's actual hour — at night it
 * becomes a moon. Weather refreshes at most every 15 minutes (open-meteo.com).
 * Standalone full-bleed page; deliberately outside Layout.astro.
 */
import { safeJsonLd } from '../lib/jsonld';

const title = 'Waves - mgg';
const canonicalURL = new URL('/waves', Astro.site);
const ogImage = new URL('/waves-og.png', Astro.site).toString();

const artworkJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: 'Waves',
  url: canonicalURL.toString(),
  image: ogImage,
  artMedium: 'WebGL shader, ordered dithering',
  creator: { '@type': 'Person', name: 'Martín Granados García', url: 'https://martingranados.com' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Martín Granados García" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@martingranadosg" />
    <meta name="twitter:creator" content="@martingranadosg" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={safeJsonLd(artworkJsonLd)} />
  </head>
  <body>
    <canvas id="c"></canvas>
    <div id="cap">
      <b>Watching waves</b><span id="wx"></span><span class="src">weather · open-meteo.com</span>
    </div>

    <style is:global>
      html,
      body {
        margin: 0;
        height: 100%;
        overflow: hidden;
        background: #111;
      }
      canvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        display: block;
      }
      #cap {
        position: fixed;
        top: 26px;
        left: 30px;
        z-index: 2;
        color: #d6d2c2;
        opacity: 0.65;
        font:
          11px/1.7 'Avenir Next',
          'Helvetica Neue',
          system-ui,
          sans-serif;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        user-select: none;
        transition: opacity 0.8s ease;
      }
      #cap b {
        display: block;
        font-weight: 600;
      }
      #cap.hidden {
        opacity: 0;
      }
      #wx {
        display: block;
      }
      #cap .src {
        display: block;
        opacity: 0.55;
      }
    </style>

    <script is:inline>
      'use strict';
      const cv = document.getElementById('c');
      const gl = cv.getContext('webgl2', { antialias: false, alpha: false });
      if (!gl) {
        document.body.innerHTML =
          '<p style="color:#ccc;font:14px sans-serif;padding:2em">WebGL2 required.</p>';
        throw new Error('no webgl2');
      }

      const FRAG = `#version 300 es
precision highp float;
uniform vec2 uRes; uniform float uTime;
uniform vec2 uSun;                                   /* sun/moon position */
uniform float uCover, uRain, uWind, uLight;          /* live Kochi weather */
out vec4 fragColor;

const float HZ = 0.58;   /* horizon, uv.y up */
const float SHV = 0.22;  /* shoreline */

float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123); }
float vnoise(vec2 p){
  vec2 i = floor(p), f = fract(p);
  vec2 u = f*f*(3.0-2.0*f);
  return mix(mix(hash(i), hash(i+vec2(1,0)), u.x),
             mix(hash(i+vec2(0,1)), hash(i+vec2(1,1)), u.x), u.y);
}
float fbm(vec2 p){
  float v = 0.0, a = 0.5;
  for (int i = 0; i < 5; i++){ v += a*vnoise(p); p = p*2.03 + vec2(19.7, 7.3); a *= 0.5; }
  return v;
}
float Bayer2(vec2 a){ a = floor(a); return fract(a.x/2.0 + a.y*a.y*0.75); }
float Bayer4(vec2 a){ return Bayer2(0.5*a)*0.25 + Bayer2(a); }
float Bayer8(vec2 a){ return Bayer4(0.5*a)*0.25 + Bayer2(a); }
vec3 grayL(float L, float k, float b){ return vec3(k*L + b); }

/* everything that gives the print its look, by name */
struct Look {
  vec2 sunPos; float sunR;
  vec3 skyA, skyB, cloudLit, cloudShade;
  vec3 seaA, seaB, foamC, sandC, wetC, sunC;
  float beamAmt, cloudCover, rainAmt;
};

vec3 scene(vec2 uv, float ar, float t, Look k){
  vec3 col;
  float x = (uv.x - 0.5) * ar;

  if (uv.y > HZ){                                   /* ----- sky */
    float ha = (uv.y - HZ) / (1.0 - HZ);
    col = mix(k.skyB, k.skyA, pow(ha, 0.8));
    /* sun / moon disc */
    float sd = length((uv - k.sunPos) * vec2(ar, 1.0));
    float glow = exp(-sd*sd*30.0) * 0.55;
    col += k.sunC * glow;
    col = mix(col, k.sunC, smoothstep(k.sunR, k.sunR*0.92, sd));
    /* projected cloud plane — big overhead, compressed at horizon */
    float dist = min(1.0 / (ha + 0.10), 6.5);
    vec2 cp = vec2(x * dist, dist) * 0.32 + vec2(t*0.012, t*0.004);
    float w = fbm(cp*1.6);
    vec2 q = cp*2.1 + vec2(w*0.9, w*0.5);
    float n = fbm(q);
    float cl = smoothstep(k.cloudCover, k.cloudCover + 0.12, n * (0.75 + 0.25*ha));
    float haze = smoothstep(0.0, 0.28, ha);          /* aerial fade at horizon */
    if (cl * haze > 0.001){                          /* skip lighting where cloudless */
      float n2 = fbm(q + vec2(0.07, 0.10));
      float lit = clamp(0.55 + (n2 - n)*7.0, 0.0, 1.0);
      col = mix(col, mix(k.cloudShade, k.cloudLit, lit), cl * haze);
    }
  } else if (uv.y > SHV){                            /* ----- sea */
    float dd = HZ - uv.y;
    float dist = min(1.0 / (dd + 0.045), 12.0);
    vec2 sp = vec2(x * dist * 0.7, dist*0.5 - t*0.55);
    float waves = fbm(sp * vec2(0.9, 1.5));
    float grade = smoothstep(0.0, 0.36, dd);
    col = mix(k.seaA, k.seaB, grade);
    col *= 0.82 + waves*0.35;
    /* sun beam column */
    float beam = k.beamAmt * smoothstep(0.30, 0.0, abs(uv.x - k.sunPos.x)) * (1.0 - grade*0.5);
    col += k.sunC * beam * 0.35;
    /* glints */
    float g = step(0.982, vnoise(sp*vec2(5.0, 16.0) + vec2(0.0, t*1.5)));
    col += (k.foamC*0.6 + k.sunC*0.4) * g * (0.25 + beam);
    /* breaking rows, denser near shore */
    float shoreFac = smoothstep(7.0, 2.4, dist);
    float row = sin(dist*3.1 - t*1.7 + waves*3.0)*0.5 + 0.5;
    float foam = smoothstep(0.78, 0.94, row) * shoreFac;
    /* torn crests */
    foam *= 0.45 + 0.55*smoothstep(0.35, 0.65, fbm(sp*vec2(3.0, 0.8)));
    col = mix(col, k.foamC, foam);
    /* horizon haze */
    col = mix(mix(k.skyB, col, 0.35), col, smoothstep(0.0, 0.05, dd));
  } else {                                           /* ----- beach */
    float wob = fbm(vec2(x*3.0, uv.y*8.0 + t*0.1));
    float swash = SHV - 0.020 - 0.022*(0.5 + 0.5*sin(t*0.42)) + wob*0.012;
    float wet = smoothstep(swash - 0.10, swash + 0.02, uv.y);
    col = mix(k.sandC, k.wetC, wet*0.85);
    /* water film above the tongue */
    float film = smoothstep(swash, swash + 0.035, uv.y);
    col = mix(col, mix(k.seaB, k.foamC, 0.35), film*0.55);
    /* foam tongue edge */
    float e = abs(uv.y - swash) - 0.004 - 0.004*wob;
    col = mix(k.foamC, col, smoothstep(0.0, 0.006, e));
    /* drying flecks */
    float fl = step(0.94, vnoise(vec2(x*90.0, uv.y*160.0)));
    col = mix(col, k.foamC, fl * (1.0 - film) * wet * 0.5);
  }

  /* rain squalls hanging under the front, far out at sea */
  if (k.rainAmt > 0.0){
    float sq = smoothstep(0.52, 0.80, fbm(vec2(uv.x*1.8 + t*0.03, 3.7)));
    float band = smoothstep(HZ + 0.24, HZ + 0.02, uv.y)
               * smoothstep(HZ - 0.14, HZ - 0.03, uv.y);
    float streak = 0.8 + 0.2*vnoise(vec2(uv.x*90.0 + (HZ - uv.y)*45.0, uv.y*4.0 - t*0.8));
    col = mix(col, mix(k.cloudShade, k.skyB, 0.45)*streak, sq * band * k.rainAmt);
  }
  return col;
}

void main(){
  float ar = uRes.x / uRes.y;
  vec2 cell = floor(gl_FragCoord.xy);      /* FBO renders 1 fragment per dither cell */
  vec2 uv = gl_FragCoord.xy / uRes;
  float t = uTime;

  float L = uLight;                              /* sun elevation sets the light */
  Look k;
  k.sunPos = uSun; k.sunR = 0.05;
  k.skyA = grayL(L, 0.50, 0.05);  k.skyB = grayL(L, 0.92, 0.04);
  k.cloudLit = vec3(min(1.0, 0.95*L + 0.15));
  k.cloudShade = grayL(L, 0.08, 0.03);
  k.seaA = grayL(L, 0.30, 0.04);  k.seaB = grayL(L, 0.06, 0.02);
  k.foamC = grayL(L, 0.40, 0.60);
  k.sandC = grayL(L, 0.80, 0.08); k.wetC = grayL(L, 0.44, 0.05);
  k.sunC = vec3(0.85); k.beamAmt = 0.42;
  k.cloudCover = mix(0.62, 0.36, uCover) + 0.02*sin(t*0.03);
  k.rainAmt = uRain;

  vec3 c = scene(uv, ar, t * uWind, k);          /* wind sets the sea's pace */
  c = (c - 0.5) * 1.45 + 0.5;                    /* ink-press contrast */
  float on = dot(c, vec3(0.299, 0.587, 0.114)) + (Bayer8(cell) - 0.5)*0.65;
  vec3 ink = vec3(0.10, 0.10, 0.09), paper = vec3(0.93, 0.90, 0.82);
  fragColor = vec4(on > 0.5 ? paper : ink, 1.0);
}`;

      const VERT = `#version 300 es
void main(){
  vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
  gl_Position = vec4(p*2.0 - 1.0, 0.0, 1.0);
}`;

      function compile(type, src) {
        const s = gl.createShader(type);
        gl.shaderSource(s, src);
        gl.compileShader(s);
        if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s));
        return s;
      }
      const prog = gl.createProgram();
      gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
      gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
      gl.linkProgram(prog);
      if (!gl.getProgramParameter(prog, gl.LINK_STATUS))
        throw new Error(gl.getProgramInfoLog(prog));
      gl.useProgram(prog);
      const U = Object.fromEntries(
        ['uRes', 'uTime', 'uSun', 'uCover', 'uRain', 'uWind', 'uLight'].map((n) => [
          n,
          gl.getUniformLocation(prog, n),
        ]),
      );

      const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const TSCALE = REDUCED ? 0.25 : 1; /* motion preference scales the clock only */
      const CELL_PX = 2; /* dither cell size in CSS pixels */

      /* live weather for Kochi, Japan — defaults are typical July conditions */
      const WX = { cover: 0.16, precip: 0, wind: 1.4, hour: 7.75, isDay: 1, temp: 28.5, code: 0 };
      const WMO = {
        0: 'clear',
        1: 'mostly clear',
        2: 'partly cloudy',
        3: 'overcast',
        45: 'fog',
        48: 'fog',
        51: 'drizzle',
        53: 'drizzle',
        55: 'drizzle',
        61: 'rain',
        63: 'rain',
        65: 'heavy rain',
        80: 'showers',
        81: 'showers',
        82: 'showers',
        95: 'thunderstorm',
      };
      function setWx() {
        /* Kochi in July: sun up roughly 05:10–19:10, rising screen-left (east) */
        const dayFrac = Math.min(1, Math.max(0, (WX.hour - 5.17) / 14));
        const elev = WX.isDay ? Math.sin(Math.PI * dayFrac) : 0;
        gl.uniform2f(
          U.uSun,
          ...(WX.isDay ? [0.15 + 0.7 * dayFrac, 0.62 + elev * 0.3] : [0.72, 0.8]),
        );
        gl.uniform1f(U.uCover, WX.cover);
        gl.uniform1f(U.uRain, Math.min(1, WX.precip / 2.5));
        gl.uniform1f(U.uWind, 0.12 + 0.5 * Math.min(1, WX.wind / 28)); /* calm → glassy */
        gl.uniform1f(U.uLight, WX.isDay ? 0.55 + 0.45 * elev : 0.18); /* night: moonlight */
        const hh = String(Math.floor(WX.hour)).padStart(2, '0');
        const mm = String(Math.round((WX.hour % 1) * 60)).padStart(2, '0');
        document.getElementById('wx').textContent =
          `kochi ${hh}:${mm} · ${Math.round(WX.temp)}°C · ${WMO[WX.code] || 'cloudy'} · wind ${Math.round(WX.wind)} km/h`;
      }
      /* fetch at most every 15 min, surviving reloads via localStorage */
      function fetchWx() {
        fetch(
          'https://api.open-meteo.com/v1/forecast?latitude=33.5589&longitude=133.5314' +
            '&current=temperature_2m,cloud_cover,precipitation,weather_code,wind_speed_10m,is_day&timezone=Asia%2FTokyo',
        )
          .then((r) => r.json())
          .then((j) => {
            const c = j.current;
            WX.cover = c.cloud_cover / 100;
            WX.precip = c.precipitation;
            WX.wind = c.wind_speed_10m;
            WX.isDay = c.is_day;
            WX.temp = c.temperature_2m;
            WX.code = c.weather_code;
            const tm = /T(\d\d):(\d\d)/.exec(c.time);
            if (tm) WX.hour = +tm[1] + +tm[2] / 60;
            localStorage.wx = JSON.stringify({ t: Date.now(), d: WX });
            setWx();
          })
          .catch(() => {}); /* offline: keep last known conditions */
      }
      try {
        const saved = JSON.parse(localStorage.wx);
        if (Date.now() - saved.t < 9e5) Object.assign(WX, saved.d);
        else fetchWx();
      } catch {
        fetchWx();
      }
      setInterval(fetchWx, 9e5);

      const cap = document.getElementById('cap');
      let hideTimer;
      function poke() {
        cap.classList.remove('hidden');
        clearTimeout(hideTimer);
        hideTimer = setTimeout(() => cap.classList.add('hidden'), 3500);
      }
      addEventListener('pointermove', poke);
      poke();

      let DPR = 1;
      function resize() {
        DPR = Math.min(devicePixelRatio || 1, 2);
        cv.width = Math.round(innerWidth * DPR);
        cv.height = Math.round(innerHeight * DPR);
      }
      addEventListener('resize', resize);
      resize();

      /* render at dither-cell resolution, nearest-upscale to screen: 16x fewer fragments */
      let fbo = null,
        rb = null,
        lw = 0,
        lh = 0;
      function ensureFbo(w, h) {
        if (lw === w && lh === h) return;
        lw = w;
        lh = h;
        if (!fbo) {
          fbo = gl.createFramebuffer();
          rb = gl.createRenderbuffer();
        }
        gl.bindRenderbuffer(gl.RENDERBUFFER, rb);
        gl.renderbufferStorage(gl.RENDERBUFFER, gl.RGBA8, w, h);
        gl.bindFramebuffer(gl.FRAMEBUFFER, fbo);
        gl.framebufferRenderbuffer(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.RENDERBUFFER, rb);
        gl.viewport(0, 0, w, h);
        gl.uniform2f(U.uRes, w, h);
      }

      /* random start time: a different stretch of sky and swell every visit */
      let raf = null,
        t0 = performance.now(),
        tAcc = Math.random() * 600;
      function frame(now) {
        raf = requestAnimationFrame(frame);
        const dt = Math.min(0.05, (now - t0) / 1000);
        t0 = now;
        tAcc += dt * TSCALE;
        const cell = Math.max(1, Math.round(CELL_PX * DPR));
        ensureFbo(Math.ceil(cv.width / cell), Math.ceil(cv.height / cell));
        gl.bindFramebuffer(gl.FRAMEBUFFER, fbo);
        gl.uniform1f(U.uTime, tAcc);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
        gl.bindFramebuffer(gl.DRAW_FRAMEBUFFER, null);
        gl.blitFramebuffer(
          0,
          0,
          lw,
          lh,
          0,
          0,
          cv.width,
          cv.height,
          gl.COLOR_BUFFER_BIT,
          gl.NEAREST,
        );
      }
      function start() {
        t0 = performance.now();
        raf = requestAnimationFrame(frame);
      }
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          cancelAnimationFrame(raf);
          raf = null;
        } else if (!raf) start();
      });
      setWx();
      start();
    </script>
  </body>
</html>
